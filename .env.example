# Backend (apps/api/.env)

# PostgreSQL connection string (Railway PostgreSQL plugin or local DB)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/graceai
# Redis connection string (Railway Redis plugin or local Redis)
REDIS_URL=redis://localhost:6379/0

# Clerk secret key from Clerk dashboard -> API Keys
CLERK_SECRET_KEY=sk_test_...
# Clerk publishable key from Clerk dashboard -> API Keys
CLERK_PUBLISHABLE_KEY=pk_test_...

# Twilio credentials from Twilio Console -> Account
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_API_KEY=SK...
TWILIO_API_SECRET=...

# ElevenLabs API key from ElevenLabs profile settings
ELEVENLABS_API_KEY=...
# Deepgram API key from Deepgram dashboard
DEEPGRAM_API_KEY=...
# OpenAI API key from OpenAI dashboard
OPENAI_API_KEY=sk-...
# Anthropic API key from Anthropic console
ANTHROPIC_API_KEY=sk-ant-...

# Stripe secret key and webhook secret from Stripe dashboard
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe recurring price IDs for Starter and Pro plans
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...

# Cloudflare R2 credentials and bucket details
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=grace-ai-audio

# Pinecone API key and index name
PINECONE_API_KEY=...
PINECONE_INDEX=grace-ai

# App URLs
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Runtime environment and backend Sentry DSN
ENVIRONMENT=development
SENTRY_DSN=

# Frontend (apps/web/.env.local)

# Backend API URL used by Next.js frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
# Clerk keys for frontend + server rendering in Next.js
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Frontend URL (used in redirects and callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Google Identity client ID (for dev-mode Google login button)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Frontend Sentry DSN for browser error tracking
NEXT_PUBLIC_SENTRY_DSN=
